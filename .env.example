# Keep the panel bound to this computer unless you intentionally need LAN access.
HOST=127.0.0.1
PORT=3000

# Generate a long random value before use, for example with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Optional but required to create additional admin accounts. Keep this separate from account passwords.
ADMIN_CREATION_CODE=replace-with-a-separate-random-code-at-least-24-characters

# Use absolute Windows paths, with forward or escaped backslashes.
MC_SERVER_DIR=C:/Minecraft/MyServer
# MC_SERVER_JAR=C:/Minecraft/MyServer/server.jar
JAVA_COMMAND="C:/Program Files/Eclipse Adoptium/jdk-25.0.4.7-hotspot/bin/java.exe"

# Set true only when serving behind HTTPS.
COOKIE_SECURE=false
